# Copy to .env or set in Render > Environment. All optional.
MAX_UPLOAD_MB=60
MAX_VIDEO_SECONDS=120
VIDEO_SAMPLE_EVERY_SEC=1.0
SYNC_ANALYSIS_FPS=12
ENABLE_WHISPER=1
WHISPER_MODEL=tiny
# TRUTHLENS_DATA_DIR=./data
# Signing key for report seals (auto-generated into data/secret.key if not set)
# TRUTHLENS_SECRET=change-me-to-a-long-random-string
